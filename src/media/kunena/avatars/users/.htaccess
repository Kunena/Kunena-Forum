# Kunena: uploaded files must never be executed as scripts.
Options -Indexes
<FilesMatch "(?i)\.(php[0-9]*|phtml|phar|pl|py|cgi|sh|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
