<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE extension>
<extension
    type="plugin"
    group="kunena"
    method="upgrade">
    <name>plg_kunena_acl</name>
    <version>@kunenaversion@</version>
    <creationDate>@kunenaversiondate@</creationDate>
    <author>Kunena Team</author>
    <authorEmail>Kunena@kunena.org</authorEmail>
    <authorUrl>https://www.kunena.org</authorUrl>
    <copyright>www.kunena.org</copyright>
    <license>GNU/GPLv3 or later</license>
    <description>PLG_KUNENA_ACL_DESCRIPTION</description>
    <namespace path="src">Kunena\Forum\Plugin\Kunena\Acl</namespace>
    <changelogurl>@kunenachangelog@</changelogurl>
    <scriptfile>script.php</scriptfile>
    <files>
        <folder>language</folder>
        <folder plugin="acl">src</folder>
        <folder>services</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="access"
                    type="radio"
                    default="1"
                    layout="joomla.form.field.radio.switcher"
                    label="PLG_KUNENA_ACL_ACCESS"
                    description="PLG_KUNENA_ACL_ACCESS_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>
