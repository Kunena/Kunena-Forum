{
	"name" : "kunena/kunena-forum",
	"description" : "Kunena Forum for joomla",
	"homepage" : "https://github.com/Kunena/Kunena-Forum",
	"license" : "GPL-3.0-or-later",
	"require-dev" : {
		"phpunit/phpunit" : "^13.4.7",
		"friendsofphp/php-cs-fixer" : "~3.95.31",
		"codeception/codeception" : "~5.3.7",
		"symfony/css-selector" : "^8.1.10",
		"phing/phing" : "dev-main",
		"squizlabs/php_codesniffer": "^4.0.4",
		"vimeo/psalm": "^7.9.0"
	},
	"config" : {
		"allow-plugins" : true
	},
	"scripts" : {
		"test" : "phpunit",
		"test:unit" : "phpunit --testsuite Unit",
		"test:integration" : "phpunit --testsuite Integration"
	},
	"minimum-stability" : "dev",
	"prefer-stable" : true
}
