<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE extension>
<extension
    type="plugin"
    group="kunena"
    method="upgrade">
    <name>plg_kunena_inbox</name>
    <version>@kunenaversion@</version>
    <creationDate>@kunenaversiondate@</creationDate>
    <author>Kunena Team</author>
    <authorEmail>Kunena@kunena.org</authorEmail>
    <authorUrl>https://www.kunena.org</authorUrl>
    <copyright>www.kunena.org</copyright>
    <license>GNU/GPLv3 or later</license>
    <description>PLG_KUNENA_INBOX_DESCRIPTION</description>
    <namespace path="src">Kunena\Forum\Plugin\Kunena\Inbox</namespace>
    <changelogurl>@kunenachangelog@</changelogurl>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>
    <files>
        <folder>language</folder>
        <folder plugin="inbox">src</folder>
        <folder>services</folder>
        <folder>sql</folder>
        <folder>tmpl</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="private"
                    type="list"
                    default="1"
                    label="PLG_KUNENA_INBOX_PRIVATE"
                    description="PLG_KUNENA_INBOX_PRIVATE_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="notifications"
                    type="list"
                    default="1"
                    label="PLG_KUNENA_INBOX_NOTIFICATIONS"
                    description="PLG_KUNENA_INBOX_NOTIFICATIONS_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="emailDefault"
                    type="list"
                    default="1"
                    label="PLG_KUNENA_INBOX_EMAIL_DEFAULT"
                    description="PLG_KUNENA_INBOX_EMAIL_DEFAULT_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="attachments"
                    type="list"
                    default="1"
                    label="PLG_KUNENA_INBOX_ATTACHMENTS"
                    description="PLG_KUNENA_INBOX_ATTACHMENTS_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="attachmentMax"
                    type="number"
                    default="3"
                    min="1"
                    step="1"
                    label="PLG_KUNENA_INBOX_ATTACHMENT_MAX"
                    description="PLG_KUNENA_INBOX_ATTACHMENT_MAX_DESC"
                    class="inputbox"/>
                <field
                    name="deleteReadDays"
                    type="number"
                    default="0"
                    min="0"
                    step="1"
                    label="PLG_KUNENA_INBOX_DELETE_READ_DAYS"
                    description="PLG_KUNENA_INBOX_DELETE_READ_DAYS_DESC"
                    class="inputbox"/>
            </fieldset>
        </fields>
    </config>
</extension>
