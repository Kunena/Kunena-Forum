<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE extension>
<extension
    type="plugin"
    group="kunena"
    method="upgrade">
    <name>plg_kunena_uddeim</name>
    <version>@kunenaversion@</version>
    <creationDate>@kunenaversiondate@</creationDate>
    <author>Kunena Team</author>
    <authorEmail>Kunena@kunena.org</authorEmail>
    <authorUrl>https://www.kunena.org</authorUrl>
    <copyright>www.kunena.org</copyright>
    <license>GNU/GPLv3 or later</license>
    <description>PLG_KUNENA_UDDEIM_DESCRIPTION</description>
    <namespace path="src">Kunena\Forum\Plugin\Kunena\Uddeim</namespace>
    <changelogurl>@kunenachangelog@</changelogurl>
    <scriptfile>script.php</scriptfile>
    <files>
        <filename>Uddeim.xml</filename>
        <folder>language</folder>
        <folder plugin="uddeim">src</folder>
        <folder>services</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="private"
                    type="list"
                    default="1"
                    label="PLG_KUNENA_UDDEIM_PRIVATE"
                    description="PLG_KUNENA_UDDEIM_PRIVATE_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </config>
</extension>