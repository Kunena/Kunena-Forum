<?xml version="1.0" encoding="utf-8"?>
<extension
    type="plugin"
    group="system"
    method="upgrade">
    <name>plg_system_kunena</name>
    <version>@kunenaversion@</version>
    <creationDate>@kunenaversiondate@</creationDate>
    <author>Kunena Team</author>
    <authorEmail>Kunena@kunena.org</authorEmail>
    <authorUrl>https://www.kunena.org</authorUrl>
    <copyright>www.kunena.org</copyright>
    <license>GNU/GPLv3 or later</license>
    <description>PLG_SYSTEM_KUNENA_DESC</description>
    <namespace path="src">Kunena\Forum\Plugin\System\Kunena</namespace>
    <changelogurl>@kunenachangelog@</changelogurl>
    <scriptfile>script.php</scriptfile>
    <files>
        <filename>kunena.xml</filename>
        <folder>language</folder>
        <folder plugin="kunena">src</folder>
        <folder>services</folder>
    </files>
    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="jcontentevents"
                    type="list"
                    default="0"
                    label="PLG_SYSTEM_KUNENA_JCONTENTPLUGINS"
                    description="PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_DESC"
                    class="inputbox">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="jcontentevent_target"
                    type="list"
                    multiple="true"
                    default=""
                    label="PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET"
                    description="PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_DESC"
                    class="inputbox">
                    <option value="title">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_TITLES</option>
                    <option value="body">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_BODIES</option>
                    <option value="announcement_title">announcement_title</option>
                    <option value="announcement_sdescription">announcement_sdescription</option>
                    <option value="announcement_description">announcement_description</option>
                    <option value="category_headerdesc">category_headerdesc</option>
                    <option value="section_headerdesc">section_headerdesc</option>
                    <option value="page_top">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_PAGE_TOP</option>
                    <option value="page_bottom">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_PAGE_BOTTOM</option>
                    <option value="page_login">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_PAGE_LOGIN</option>
                    <option value="page_custom">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_PAGE_CUSTOM</option>
                    <option value="index_top">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_INDEX_TOP</option>
                    <option value="index_bottom">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_INDEX_BOTTOM</option>
                    <option value="index_sections">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_INDEX_SECTIONS</option>
                    <option value="topic_list_default">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_TOPIC_LIST_DEFAULT</option>
                    <option value="topic_list_rows">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_TOPIC_LIST_ROWS</option>
                    <option value="topic_top">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_TOPIC_TOP</option>
                    <option value="topic_poll">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_TOPIC_POLL</option>
                    <option value="topic_messages">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_TOPIC_MESSAGES</option>
                    <option value="topic_profiles">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_TOPIC_PROFILES</option>
                    <option value="message_list_rows">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_MESSAGE_LIST_ROWS</option>
                    <option value="profile_summary">PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_TARGET_PROFILE_SUMMARY</option>
                    <option value="message">messages</option>
                </field>
                <field
                    name="jcontentevent_plugins"
                    type="plugins"
                    folder="content"
                    multiple="true"
                    default=""
                    label="PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_SELECTED"
                    description="PLG_SYSTEM_KUNENA_JCONTENTPLUGINS_SELECTED_DESC"
                    showon="jcontentevents:1"
                    class="inputbox" />
                <field
                    name="ban_check_last"
                    type="hidden"
                    default="0" />
            </fieldset>
        </fields>
    </config>
</extension>