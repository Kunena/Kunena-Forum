<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE metadata>
<metadata>
    <layout title="COM_KUNENA_MENU_HOME_DEFAULT">
        <message>COM_KUNENA_MENU_HOME_DEFAULT_DESC</message>
    </layout>

    <!-- Add fields to the request variables for the layout. -->
    <fields name="request">
        <fieldset name="request">
            <field name="defaultmenu"
                   type="menuitem"
                   label="COM_KUNENA_MENU_DEFAULTITEM"
                   description="COM_KUNENA_MENU_DEFAULTITEM_DESC"
                   required="true"
                   state="1"
            />
        </fieldset>
    </fields>

    <fields name="params">
        <fieldset name="basic" label="COM_KUNENA_ATTRIBS_MAIN_SETTINGS_LABEL" addfieldprefix="Kunena\Forum\Administrator\Field">
            <field name="catids"
                   type="kunenacategorylist"
                   default="0"
                   label="COM_KUNENA_MENU_HOME_CATIDS"
                   description="COM_KUNENA_MENU_HOME_CATIDS_DESC"
                   multiple="true"
                   size="10">
                <option value="0">COM_KUNENA_A_ALL_CATEGORIES</option>
            </field>
        </fieldset>
    </fields>
</metadata>
