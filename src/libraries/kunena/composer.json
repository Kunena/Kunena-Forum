{
    "name": "kunena/kunena-libraries",
    "description": "Kunena Forum core libraries autoload",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Kunena\\Forum\\": "src/",
            "KunenaScssPhp\\ScssPhp\\": "External/scssphp/scssphp/src/",
            "KunenaScssPhp\\SourceSpan\\": "External/scssphp/source-span/src/",
            "KunenaScssPhp\\League\\Uri\\": ["External/league/uri/", "External/league/uri-interfaces/"],
            "KunenaScssPhp\\Symfony\\Component\\Filesystem\\": "External/symfony/filesystem/",
            "Nbbc\\": "External/Nbbc/src/",
            "Pedrollo\\GravatarLib\\": "External/Emberlabs/",
            "enshrined\\svgSanitize\\": "External/enshrined/svg-sanitize/src/"
        },
        "classmap": [
            "External/composer/InstalledVersions.php"
        ]
    },
    "config": {
        "vendor-dir": "External"
    }
}